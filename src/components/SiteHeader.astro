---
import { profile } from '../data/profile';

const { pathname } = Astro.url;
const aboutPage = pathname === '/about/';
const currentWork = pathname === '/work/' ? 'page' : pathname.startsWith('/work/') ? 'location' : undefined;
---

<a class="skip-link type-label" href="#main-content" tabindex="0">Skip to content</a>
<header class="site-header type-label">
  <a class="home-link" href="/" tabindex="0" aria-label={`${profile.name}, home`} aria-current={pathname === '/' ? 'page' : undefined}><span>{profile.name}</span></a>
  <nav aria-label="Primary" class="primary-nav">
    <a href="/work/" tabindex="0" aria-current={currentWork}><span>Work</span></a>
    <a href="/about/" tabindex="0" data-about-link aria-current={aboutPage ? 'page' : undefined}><span>About</span></a>
    <a href="/about/#contact" tabindex="0" data-contact-link><span>Contact</span></a>
  </nav>
</header>

{aboutPage && (
  <script is:inline>
    (() => {
      const about = document.querySelector('[data-about-link]');
      const contact = document.querySelector('[data-contact-link]');

      function syncCurrentLink() {
        const atContact = location.hash === '#contact';
        const current = atContact ? contact : about;
        const other = atContact ? about : contact;
        other.removeAttribute('aria-current');
        current.setAttribute('aria-current', atContact ? 'location' : 'page');
      }

      syncCurrentLink();
      window.addEventListener('hashchange', syncCurrentLink);
      window.addEventListener('pageshow', syncCurrentLink);
    })();
  </script>
)}

<style>
  .skip-link {
    position: fixed;
    z-index: 60;
    inset-block-start: 0.5rem;
    inset-inline-start: var(--page-margin);
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    padding-inline: 1rem;
    background: var(--color-link);
    color: var(--color-paper);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus {
    transform: none;
  }

  /* Fixed over the work. Difference blending keeps the words legible over light and dark artwork;
     with keyboard focus inside, the header turns solid so the focus ring keeps its true color. */
  .site-header {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem var(--grid-gap);
    /* Full-width bar; the padding lines its contents up with the page container on wide screens. */
    padding: clamp(0.25rem, 1vw, 0.75rem) max(var(--page-margin), calc((100% - var(--content-width)) / 2));
    color: #fff;
    mix-blend-mode: difference;
    font-size: 1rem;
  }

  .site-header:focus-within {
    mix-blend-mode: normal;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 0 clamp(0.875rem, 2.6vw, 2.25rem);
  }

  .site-header a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header .home-link { white-space: nowrap; }

  /* Underlines are drawn with transform only (no repaint), growing from the left. */
  .site-header a span { position: relative; }
  .site-header a span::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.15em;
    block-size: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .site-header a[aria-current]:not(.home-link) span::after,
  :global(body:has(#contact:target)) .primary-nav [data-contact-link] span::after {
    transform: scaleX(1);
  }

  :global(body:has(#contact:target)) .primary-nav [data-about-link]:not(:focus-visible) span::after {
    transform: scaleX(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-header a:hover span::after { transform: scaleX(1); }
    @media (prefers-reduced-motion: no-preference) {
      .site-header a span::after { transition: transform 150ms var(--ease-out-strong); }
      .site-header a:hover span::after { transition-duration: 200ms; }
    }
  }

  /* On narrow screens text scrolls right under the header, so it sits on solid night instead of blending. */
  @media (max-width: 51.25em) {
    .site-header {
      mix-blend-mode: normal;
      background: var(--color-paper);
      color: var(--color-ink);
    }
  }

  /* The smallest phones: tighter spacing keeps the name and all three links inside the margins. */
  @media (max-width: 22.4375em) {
    .site-header { font-size: 0.9375rem; }
    .primary-nav { gap: 0 0.75rem; }
  }

  @media (min-width: 64em) {
    .site-header {
      font-size: 1.0625rem;
    }
  }
</style>
