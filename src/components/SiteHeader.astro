---
import { profile } from '../data/profile';

const { pathname } = Astro.url;
const aboutPage = pathname === '/about/';
const currentWork = pathname === '/work/' ? 'page' : pathname.startsWith('/work/') ? 'location' : undefined;
---

<a class="skip-link type-label" href="#main-content" tabindex="0">Skip to content</a>
<header class="site-header type-label">
  <a class="home-link" href="/" tabindex="0" aria-label={`${profile.name}, home`} aria-current={pathname === '/' ? 'page' : undefined}><span>{profile.name}</span></a>
  <!-- Davao local time: it's an Afterhours portfolio, so visitors can see when it's night in Davao. -->
  <p class="local-time">{profile.location.split(',')[0]}<span data-clock></span></p>
  <div class="end">
    <nav aria-label="Primary" class="primary-nav">
      <a href="/work/" tabindex="0" aria-current={currentWork}><span>Work</span></a>
      <a href="/about/" tabindex="0" data-about-link aria-current={aboutPage ? 'page' : undefined}><span>About</span></a>
      <a href="/about/#contact" tabindex="0" data-contact-link><span>Contact</span></a>
    </nav>
    <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Day mode" data-theme-toggle>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" /></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" /></svg>
    </button>
  </div>
</header>

<script>
  // Davao local time, refreshed on the minute.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit' });
    const tick = () => { clock.textContent = `, ${format.format(new Date())}`; };
    tick();
    setTimeout(() => { tick(); setInterval(tick, 60_000); }, 60_000 - (Date.now() % 60_000));
  }

  // Day mode: a per-visitor preference. Night (Afterhours) stays the default.
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => {
    const day = root.dataset.theme === 'day';
    toggle?.setAttribute('aria-pressed', String(day));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', day ? '#f4f1ec' : '#0b0712');
  };
  sync();
  toggle?.addEventListener('click', () => {
    const day = root.dataset.theme !== 'day';
    if (day) root.dataset.theme = 'day'; else delete root.dataset.theme;
    try { localStorage.setItem('yancy:theme', day ? 'day' : 'night'); } catch { /* The choice simply isn't remembered. */ }
    sync();
  });
</script>

{aboutPage && (
  <script is:inline>
    (() => {
      const about = document.querySelector('[data-about-link]');
      const contact = document.querySelector('[data-contact-link]');

      function syncCurrentLink() {
        const atContact = location.hash === '#contact';
        const current = atContact ? contact : about;
        const other = atContact ? about : contact;
        other.removeAttribute('aria-current');
        current.setAttribute('aria-current', atContact ? 'location' : 'page');
      }

      syncCurrentLink();
      window.addEventListener('hashchange', syncCurrentLink);
      window.addEventListener('pageshow', syncCurrentLink);
    })();
  </script>
)}

<style>
  .skip-link {
    position: fixed;
    z-index: 60;
    inset-block-start: 0.5rem;
    inset-inline-start: var(--page-margin);
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    padding-inline: 1rem;
    background: var(--color-link);
    color: var(--color-paper);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus {
    transform: none;
  }

  /* Fixed over the work. Difference blending keeps the words legible over light and dark artwork;
     with keyboard focus inside, the header turns solid so the focus ring keeps its true color. */
  .site-header {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem var(--grid-gap);
    /* Full-width bar; the padding lines its contents up with the page container on wide screens. */
    padding: clamp(0.25rem, 1vw, 0.75rem) max(var(--page-margin), calc((100% - var(--content-width)) / 2));
    color: #fff;
    mix-blend-mode: difference;
    font-size: 1rem;
  }

  .site-header:focus-within {
    mix-blend-mode: normal;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .end { display: flex; align-items: center; gap: clamp(0.5rem, 1.6vw, 1.25rem); }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 0 clamp(1rem, 2.6vw, 2.25rem);
  }

  .local-time {
    display: none;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (min-width: 64em) { .local-time { display: block; } }

  .theme-toggle {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: var(--target-size);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .theme-toggle svg { inline-size: 1.125rem; block-size: 1.125rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }
  .theme-toggle .moon { display: none; fill: currentColor; stroke: none; }
  .theme-toggle[aria-pressed='true'] .sun { display: none; }
  .theme-toggle[aria-pressed='true'] .moon { display: block; }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle { transition: transform 160ms var(--ease-out-strong); }
    .theme-toggle:active { transform: scale(0.94); }
  }

  .site-header a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header .home-link { white-space: nowrap; }

  /* Underlines are drawn with transform only (no repaint), growing from the left. */
  .site-header a span { position: relative; }
  .site-header a span::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.15em;
    block-size: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .site-header a[aria-current]:not(.home-link) span::after,
  :global(body:has(#contact:target)) .primary-nav [data-contact-link] span::after {
    transform: scaleX(1);
  }

  :global(body:has(#contact:target)) .primary-nav [data-about-link]:not(:focus-visible) span::after {
    transform: scaleX(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-header a:hover span::after { transform: scaleX(1); }
    @media (prefers-reduced-motion: no-preference) {
      .site-header a span::after { transition: transform 150ms var(--ease-out-strong); }
      .site-header a:hover span::after { transition-duration: 200ms; }
    }
  }

  /* On narrow screens text scrolls right under the header, so it sits on solid night instead of blending. */
  @media (max-width: 51.25em) {
    .site-header {
      mix-blend-mode: normal;
      background: var(--color-paper);
      color: var(--color-ink);
    }
  }

  /* The smallest phones: tighter spacing keeps the name and all three links inside the margins. */
  @media (max-width: 22.4375em) {
    .site-header { font-size: 0.9375rem; }
    .primary-nav { gap: 0 0.75rem; }
    /* No room beside the three links on the smallest phones. */
    .theme-toggle { display: none; }
  }

  @media (min-width: 64em) {
    .site-header {
      font-size: 1.0625rem;
    }
  }
</style>
