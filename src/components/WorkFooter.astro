---
import ProjectName from './ProjectName.astro';

interface Props {
  category: { title: string; href: string };
  next: { title: string; href: string; titleParts?: string[] };
  nextLabel?: string;
}
const { category, next, nextLabel = 'Next project' } = Astro.props;
---

<nav class="case-footer" aria-label="Explore other work">
  <a class="back type-label" href={category.href} tabindex="0">Back to {category.title}</a>
  <a class="next" href={next.href} tabindex="0" data-case-link>
    <span class="type-label">{nextLabel}</span>
    <span data-case-title><ProjectName title={next.title} titleParts={next.titleParts} /></span>
  </a>
</nav>
