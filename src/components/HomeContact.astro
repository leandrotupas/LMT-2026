---
import { profile } from '../data/profile';
---

<section class="contact" aria-labelledby="home-contact-heading">
  <h2 id="home-contact-heading" class="visually-hidden">Contact</h2>
  <p class="availability">{profile.availability}</p>
  <a class="mail type-poster" href={`mailto:${profile.email}`}>{profile.email}</a>
  <div class="foot type-label">
    <nav aria-label="Profiles">
      {profile.socialProfiles.map(({ name, url }) => <a href={url}>{name}</a>)}
      <a href={profile.resume.href}>Résumé <span class="visually-hidden">(PDF, {profile.resume.pages} pages)</span></a>
    </nav>
    <span>© 2026 {profile.name}</span>
  </div>
</section>

<style>
  .contact {
    padding: clamp(4rem, 14vh, 10rem) var(--page-margin) 2rem;
    border-block-start: 1px solid var(--color-divider);
  }

  .availability {
    max-inline-size: 34ch;
    color: var(--color-secondary);
    font-size: clamp(1.1875rem, 1.6vw, 1.5rem);
  }

  .mail {
    display: inline-block;
    margin-block: clamp(1.125rem, 3vh, 2rem) clamp(4rem, 12vh, 8.75rem);
    color: var(--color-ink);
    font-size: clamp(2.75rem, 8.4vw, 9.75rem);
    line-height: 0.9;
    overflow-wrap: anywhere;
    text-decoration: none;
    background: linear-gradient(var(--color-link), var(--color-link)) 0 100% / 0 0.06em no-repeat;
    transition: background-size 500ms var(--ease-in-out-strong), color 300ms ease;
  }

  @media (hover: hover) { .mail:hover { background-size: 100% 0.06em; color: var(--color-link); } }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.75rem;
    color: var(--color-secondary);
  }

  .foot nav { display: flex; flex-wrap: wrap; gap: 0 1.75rem; }
  .foot a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    color: var(--color-ink);
    text-decoration: none;
  }
  .foot a:hover { color: var(--color-link); }

  @media (prefers-reduced-motion: reduce) { .mail { transition: color 200ms ease; } }
</style>
