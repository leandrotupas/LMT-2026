---
import initials from '../assets/lmt-initials.png';
import signatureMark from '../assets/lmt-signature.png';
import { profile } from '../data/profile';

const [givenName, ...familyName] = profile.name.split(' ');
---

<header class="signature layout-grid" data-signature>
  <img
    class="initials"
    src={initials.src}
    srcset={`${initials.src} 192w, ${signatureMark.src} 408w`}
    sizes="(min-width: 64em) 136px, (min-width: 37.5em) 96px, 76px"
    width={signatureMark.width}
    height={signatureMark.height}
    alt="LMT initials"
  />
  <div class="signature-line">
    <h1 aria-label={profile.name}><span class="word given-name" data-outline={givenName}><span class="ink">{givenName}</span></span>{' '}<span class="word family-name" data-outline={familyName.join(' ')}><span class="ink">{familyName.join(' ')}</span></span></h1>
  </div>
  <div class="signature-details">
    <p class="role">{profile.role}</p>
    <p class="city">{profile.location}</p>
  </div>
  <button class="replay" type="button" aria-label="Replay intro" hidden>
    <span class="replay-arrow" aria-hidden="true">↺</span>
    <span>Replay<span class="replay-desktop"> intro</span></span>
  </button>
</header>

<script is:inline>
  (() => {
    const signature = document.querySelector('[data-signature]');
    const replay = signature.querySelector('.replay');
    const lastInk = signature.querySelector('.family-name .ink');
    const motion = matchMedia('(prefers-reduced-motion: no-preference) and (forced-colors: none)');
    const settle = () => signature.classList.remove('is-signing');

    function play() {
      if (!motion.matches) return;
      if (signature.classList.contains('is-signing')) {
        settle();
        // Commit the settled style before starting a second impression.
        getComputedStyle(lastInk).animationName;
      }
      signature.classList.add('is-signing');
    }

    function syncPreference() {
      settle();
      replay.hidden = !motion.matches;
    }

    syncPreference();
    motion.addEventListener('change', syncPreference);
    lastInk.addEventListener('animationend', (event) => {
      if (event.elapsedTime && !lastInk.getAnimations().some((animation) => animation.playState === 'running')) settle();
    });
    window.addEventListener('keydown', (event) => { if (event.key === 'Tab' || event.key === 'Escape') settle(); });
    window.addEventListener('pagehide', settle);
    replay.addEventListener('click', play);

    try {
      const key = 'yancy:ink-signature-seen';
      if (!sessionStorage.getItem(key)) {
        sessionStorage.setItem(key, '1');
        if (document.documentElement.dataset.input !== 'keyboard') play();
      }
    } catch {
      // Replay remains available when session storage is unavailable.
    }
  })();
</script>

<style>
  .signature {
    position: relative;
    grid-template-rows: auto auto;
    align-items: start;
    row-gap: clamp(1.35rem, 2.4vw, 2.125rem);
    padding-block: clamp(2.75rem, 7.5vw, 7rem) clamp(3.5rem, 7.5vw, 7.5rem);
  }

  .initials {
    grid-area: 1 / 1;
    inline-size: clamp(4rem, 18vw, 4.75rem);
    margin-block-start: 0.24rem;
  }

  .signature-line {
    grid-area: 1 / 2 / 2 / -1;
    min-inline-size: 0;
    container-type: inline-size;
  }

  h1 {
    font-size: clamp(2.75rem, 32.5cqi, 6.5rem);
    font-weight: 650;
    font-variation-settings: 'opsz' 96;
    line-height: 0.93;
    letter-spacing: var(--display-tracking);
  }

  .word {
    position: relative;
    display: block;
    inline-size: max-content;
    max-inline-size: 100%;
  }
  .ink { display: inline-block; }
  .family-name { margin-inline-start: min(12cqi, 0.7em); }

  .signature-details {
    grid-area: 2 / 2 / 3 / -1;
    align-self: center;
    line-height: 1.3;
  }

  .role {
    font-size: clamp(1.04rem, 1.65vw, 1.5rem);
    font-weight: 560;
  }

  .city {
    margin-block-start: 0.25em;
    color: var(--color-secondary);
    font-size: clamp(0.875rem, 1.25vw, 1rem);
  }

  .replay {
    grid-area: 1 / 1;
    align-self: start;
    justify-self: start;
    display: inline-flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.32em;
    margin-block-start: calc(clamp(4rem, 18vw, 4.75rem) + 0.42rem);
    min-block-size: var(--target-size);
    min-inline-size: var(--target-size);
    max-inline-size: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-secondary);
    font: 500 0.8125rem/1.2 var(--font-sans);
    text-align: start;
    cursor: pointer;
  }

  .replay[hidden] { display: none; }
  .replay-desktop { display: none; }
  .replay:is(:hover, :focus-visible) { color: var(--color-link); }
  .replay-arrow { font: 1.2em/1 Arial, sans-serif; }

  @container homepage (min-width: 32rem) {
    .signature {
      row-gap: clamp(1rem, 2.5vw, 2.5rem);
      padding-block: clamp(2.75rem, 6.4svh, 6rem) clamp(3.25rem, 8svh, 7rem);
    }
    .initials {
      grid-column: 1 / 3;
      inline-size: clamp(5.5rem, 9.5vw, 8.5rem);
      align-self: center;
      margin-block-start: 0;
    }
    .signature-line, .signature-details { grid-column: 3 / -1; }
    .signature-line { align-self: center; }
    h1 {
      font-size: clamp(3.25rem, 18.8cqi, 13.2rem);
      white-space: nowrap;
      word-spacing: -0.06em;
    }
    .word { display: inline-block; }
    .family-name { margin-inline-start: 0; }
    .signature-details {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.35em 1.6rem;
    }
    .city { margin-block-start: 0; }
    .replay {
      grid-area: 2 / 1 / 3 / 3;
      align-self: center;
      margin-block-start: 0;
      font-size: 0.875rem;
    }
    .replay-desktop { display: inline; }
  }

  @container homepage (max-width: 16.5rem) {
    .signature {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto auto;
      row-gap: 1rem;
      padding-block: 1.5rem 2rem;
    }
    .initials { grid-area: 1 / 1; inline-size: min(3rem, 100%); }
    .replay { grid-area: 1 / 2; align-self: center; margin-block-start: 0; }
    .signature-line { grid-area: 2 / 1 / 3 / -1; }
    .signature-details { grid-area: 3 / 1 / 4 / -1; }
    .family-name { margin-inline-start: 0; }
  }

  @media (prefers-reduced-motion: no-preference) and (forced-colors: none) {
    .is-signing .word {
      --ink-delay: 0ms;
      --start-cut: inset(-30% 91% -30% -4%);
      --start-offset: translate(-0.08em, -0.17em) skewY(-3deg);
    }
    .is-signing .family-name {
      --ink-delay: 70ms;
      --start-cut: inset(-30% -4% -30% 91%);
      --start-offset: translate(0.08em, 0.17em) skewY(-3deg);
    }
    .is-signing .word::before {
      content: attr(data-outline);
      position: absolute;
      inset: 0;
      color: transparent;
      -webkit-text-stroke: max(1px, 0.011em) var(--color-secondary);
      pointer-events: none;
      user-select: none;
      animation: outline-lifts var(--duration-entrance) linear var(--ink-delay) both;
    }
    .is-signing .ink {
      animation: ink-registers var(--duration-entrance) var(--ease-entrance) var(--ink-delay) both;
    }
    @keyframes outline-lifts { 0%, 57% { opacity: 1; } 100% { opacity: 0; } }
    @keyframes ink-registers {
      from { clip-path: var(--start-cut); transform: var(--start-offset); }
      to { clip-path: inset(-30% -4% -30% -4%); transform: none; }
    }
  }
</style>
