---
import { Image } from 'astro:assets';
import { advenientArt } from '../data/advenient';
import { flagships } from '../data/flagships';
import { kotaArt } from '../data/kota';
import { projectFormats } from '../data/project-formats';
import { wunderbarArt } from '../data/wunderbar';

const companionPrints = {
  advenient: [advenientArt.outdoor, advenientArt.staff],
  'kota-center-davao': [kotaArt.story, kotaArt.panel],
  wunderbar: [wunderbarArt.illustrated, wunderbarArt.board],
};
---

<section class="flagships" data-flagships aria-labelledby="case-heading">
  <div class="section-heading">
    <h2 id="case-heading">Case Studies</h2>
    <div class="section-actions">
      <button type="button" class="preview-toggle" aria-expanded="false"
        aria-controls={flagships.map(({ slug }) => `${slug}-prints`).join(' ')} hidden>Show previews</button>
      <a class="all-work" href="/work/" tabindex="0"><span>All work</span> <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <ul role="list">
    {flagships.map((project) => {
      const asset = `/images/flagships/${project.slug}`;
      return (
        <li>
          <a
            class="project layout-grid"
            href={project.href}
            tabindex="0"
            data-share-cover={project.sharesCover || undefined}
            type={projectFormats[project.format].type}
            data-case-link={project.format === 'case' || undefined}
            aria-labelledby={`${project.slug}-title ${project.slug}-format`}
            aria-describedby={`${project.slug}-discipline ${project.slug}-year`}
          >
            <div
              class="identity"
              style={{ backgroundColor: project.identityColor, '--identity-art': `url("${asset}-identity.webp")` }}
              aria-hidden="true"
            ></div>
            <div class="project-name">
              <h3 id={`${project.slug}-title`}><span data-case-title={project.format === 'case' || undefined}>{project.title}</span></h3>
              <p id={`${project.slug}-discipline`} class="discipline">{project.discipline}</p>
            </div>
            <div class="application" id={`${project.slug}-prints`}>
              <span class="print cover-print"><img
                src={`${asset}-480.webp`}
                srcset={`${asset}-240.webp 240w, ${asset}-480.webp 480w, ${asset}-${project.largestRendition}.webp ${project.largestRendition}w`}
                sizes="(min-width: 90em) 310px, (min-width: 64em) 24vw, (min-width: 37.5em) 23vw, 26vw"
                width={project.width}
                height={project.height}
                alt={project.applicationAlt}
                decoding="async"
              /><span class="print-caption" id={`${project.slug}-cover-caption`}>{project.applicationCaption}</span></span>
              {companionPrints[project.slug].map((art, i) => (
                <span class:list={['print', 'companion', i === 0 ? 'left-print' : 'right-print']}>
                  <Image src={art.image} alt={art.alt} width={Math.min(720, art.image.width)} widths={[160, 320, 480, 720]}
                    sizes="auto, (min-width: 88em) 425px, (min-width: 37.5em) 32vw, 47vw"
                    format="webp" loading="lazy" decoding="async" />
                  <span class="print-caption" id={`${project.slug}-caption-${i}`}>{art.caption}</span>
                </span>
              ))}
            </div>
            <div class="project-meta">
              <span id={`${project.slug}-year`}>{project.year}</span>
              <span class="format" id={`${project.slug}-format`}>{projectFormats[project.format].label} <span class="open-arrow" aria-hidden="true">→</span></span>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<script>
  const selection = document.querySelector<HTMLElement>('[data-flagships]');
  const toggle = selection?.querySelector<HTMLButtonElement>('.preview-toggle');
  if (selection && toggle) {
    const rows = [...selection.querySelectorAll<HTMLAnchorElement>('.project')].map((link) => {
      const cover = link.querySelector<HTMLImageElement>('.cover-print img')!;
      const captions = [...link.querySelectorAll('.print-caption')].map((item) => item.id).join(' ');
      return { link, cover, captions, compactSizes: cover.sizes, description: link.getAttribute('aria-describedby')! };
    });
    const showSheets = (expanded: boolean, fromPointer = false) => {
      selection.toggleAttribute('data-sheets', expanded);
      if (expanded && fromPointer) selection.dataset.sheets = 'pointer';
      toggle.setAttribute('aria-expanded', String(expanded));
      toggle.textContent = expanded ? 'Hide previews' : 'Show previews';
      for (const row of rows) {
        row.cover.sizes = expanded ? '(min-width: 88em) 425px, (min-width: 37.5em) 32vw, 90vw' : row.compactSizes;
        row.link.setAttribute('aria-describedby', expanded ? `${row.description} ${row.captions}` : row.description);
      }
    };
    if (history.state?.flagshipPreviews) showSheets(true);
    toggle.hidden = false;
    toggle.addEventListener('click', (event) => {
      const expanded = !selection.hasAttribute('data-sheets');
      showSheets(expanded, event.detail > 0);
      try {
        history.replaceState({ ...history.state, flagshipPreviews: expanded }, '');
      } catch { /* The control also works when browser history is restricted. */ }
    });
  }
</script>

<style>
  .flagships { padding-block-end: var(--space-section); }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0 var(--grid-gap);
    border-block-end: 1px solid var(--color-ink);
  }

  h2 {
    font-size: clamp(1.3125rem, 2vw, 1.8rem);
    line-height: 1.2;
    letter-spacing: -0.018em;
  }

  .all-work {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    gap: 0.4em;
    font-size: 1rem;
    text-decoration: none;
  }

  .all-work span:first-child { text-decoration: underline; text-underline-offset: 0.19em; }
  .section-actions { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 clamp(0.9rem, 2.5vw, 2rem); }
  .preview-toggle {
    min-block-size: var(--target-size);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-link);
    font: inherit;
    font-size: 1rem;
    text-decoration: underline;
    text-underline-offset: 0.19em;
    cursor: pointer;
  }
  .preview-toggle:hover, .all-work:hover span:first-child { text-decoration-thickness: 2px; }
  ul { margin: 0; padding: 0; list-style: none; }
  li { border-block-end: 1px solid var(--color-divider); }

  .project {
    position: relative;
    align-items: center;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 2fr);
    row-gap: 0.3rem;
    padding-block: clamp(1.125rem, 3vw, 1.5rem);
    color: var(--color-ink);
    text-decoration: none;
  }

  .project:focus-visible { z-index: 1; }
  .identity { display: none; }
  .application {
    grid-area: 1 / 1 / 3 / 2;
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    align-items: center;
    min-inline-size: 0;
    aspect-ratio: 1.65;
  }
  .print { grid-area: 1 / 1; inline-size: 100%; block-size: 100%; min-inline-size: 0; min-block-size: 0; }
  .cover-print { z-index: 1; }
  .companion, .print-caption { display: none; }
  .application img {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 0;
    object-fit: contain;
  }

  .project-name { grid-area: 1 / 2; min-inline-size: 0; }
  h3 {
    font-size: clamp(1.35rem, 5.1vw, 1.85rem);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .discipline, .project-meta {
    color: var(--color-secondary);
    font-size: clamp(0.8125rem, 1.22vw, 1rem);
    line-height: 1.38;
  }

  .discipline { margin-block-start: 0.3rem; }
  .project-meta {
    grid-area: 2 / 2;
    display: flex;
    align-items: baseline;
    gap: 0.75em;
    font-variant-numeric: tabular-nums;
  }

  .format { display: inline-flex; align-items: baseline; gap: 0.32em; color: var(--color-link); }
  .open-arrow { font-size: 1.1em; }

  .project:focus-visible h3 span {
    text-decoration: underline;
    text-decoration-thickness: 0.055em;
    text-underline-offset: 0.13em;
    text-decoration-color: var(--color-link);
  }

  @media (hover: hover) and (pointer: fine) {
    .project::after {
      content: '';
      position: absolute;
      inset: auto 0 -1px;
      block-size: 1px;
      background: var(--color-ink);
      transform: scaleX(0);
      transform-origin: left;
      pointer-events: none;
    }
    .project:hover::after { transform: scaleX(1); }
    .project:hover h3 span {
      text-decoration: underline;
      text-decoration-thickness: 0.055em;
      text-underline-offset: 0.13em;
      text-decoration-color: var(--color-link);
    }
    .project:hover .open-arrow { transform: translateX(0.18em); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .project::after { transition: transform var(--duration-preview) var(--ease-settle); }
    .open-arrow { transition: transform var(--duration-preview) var(--ease-entrance); }
  }

  @container homepage (min-width: 32rem) {
    .project {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      min-block-size: 7.5rem;
      padding-block: 0.875rem;
    }
    .application { grid-area: 1 / 1 / 2 / 3; }
    .project-name { grid-area: 1 / 3 / 2 / 7; }
    h3 { font-size: clamp(1.6rem, 3.3vw, 2.9rem); }
    .project-meta {
      grid-area: 1 / 7 / 2 / -1;
      justify-self: end;
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @container homepage (min-width: 56rem) {
    .project { min-block-size: clamp(7.5rem, 8.8vw, 8.5rem); padding-block: 0.65rem; }
    .identity {
      grid-area: 1 / 1 / 2 / 3;
      display: grid;
      place-items: center;
      block-size: clamp(5.6rem, 7.6vw, 7.25rem);
    }
    .identity::before {
      content: '';
      inline-size: 54%;
      block-size: 55%;
      background: var(--identity-art) center / contain no-repeat;
    }
    .project-name { grid-column: 3 / 8; }
    .application {
      grid-area: 1 / 8 / 2 / 11;
      justify-items: center;
      block-size: clamp(5.6rem, 7.6vw, 7.25rem);
      aspect-ratio: auto;
    }
    .project-meta { grid-column: 11 / -1; align-items: end; }
    .companion {
      display: block;
      inline-size: 34%;
      block-size: 85%;
      opacity: var(--spread, 0);
      visibility: var(--print-visibility, hidden);
      transform: translateX(calc(var(--reach) * var(--spread, 0))) rotate(calc(var(--tilt) * var(--spread, 0)));
    }
    .left-print { --reach: -91%; --tilt: -5deg; }
    .right-print { --reach: 91%; --tilt: 5deg; }
    .cover-print { transform: scale(var(--cover-scale, 1)); }
    .project:focus-visible { --spread: 1; --print-visibility: visible; --cover-scale: var(--open-cover-scale, 0.62); }
    @media (hover: hover) and (pointer: fine) {
      .project:hover { --spread: 1; --print-visibility: visible; --cover-scale: var(--open-cover-scale, 0.62); }
      @media (prefers-reduced-motion: no-preference) {
        .project:not(:focus-visible) .print {
          transition: transform var(--duration-preview) var(--ease-settle), opacity 160ms ease-out, visibility 160ms;
        }
      }
    }
  }

  @container homepage (min-width: 67rem) {
    .project { --open-cover-scale: 0.8; }
    .companion { inline-size: 43%; block-size: 100%; }
    .left-print { --reach: -96%; }
    .right-print { --reach: 96%; }
  }

  @container homepage (max-width: 16.5rem) {
    .section-heading { flex-wrap: wrap; gap: 0; }
    .all-work { white-space: nowrap; }
    .project { grid-template-columns: minmax(0, 1fr); row-gap: 0.45rem; }
    .application { grid-area: 1 / 1; inline-size: 100%; max-inline-size: 12rem; }
    .project-name { grid-area: 2 / 1; }
    .project-meta { grid-area: 3 / 1; flex-wrap: wrap; }
  }

  [data-sheets] .project {
    grid-template: 'name meta' auto 'prints prints' auto / minmax(0, 1fr) auto;
    row-gap: 1rem;
    padding-block: clamp(1rem, 2.4vw, 2rem);
  }
  [data-sheets] .identity { display: none; }
  [data-sheets] .project-name { grid-area: name; }
  [data-sheets] .project-meta { grid-area: meta; align-items: end; justify-self: end; flex-direction: column; gap: 0.15rem; }
  [data-sheets] .application {
    grid-area: prints;
    grid-template: auto / repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--grid-gap);
    inline-size: 100%;
    max-inline-size: none;
    block-size: auto;
    aspect-ratio: auto;
  }
  [data-sheets] .project .print {
    display: block;
    grid-area: auto;
    inline-size: 100%;
    block-size: auto;
    visibility: visible;
    opacity: 1;
    transform: none;
    transition: none;
  }
  [data-sheets] .print img {
    block-size: clamp(5rem, 19vw, 12rem);
    object-position: left bottom;
  }
  [data-sheets] .print-caption {
    display: block;
    max-inline-size: 42ch;
    margin-block-start: 0.45rem;
    color: var(--color-secondary);
    font-size: 0.875rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-sheets="pointer"] .print img {
      animation: place-print 240ms var(--ease-settle) backwards;
    }
    [data-sheets="pointer"] .left-print img { animation-delay: 30ms; }
    [data-sheets="pointer"] .right-print img { animation-delay: 60ms; }
    @keyframes place-print { from { opacity: 0.55; transform: translateY(0.5rem); } }
  }
  @container homepage (max-width: 32rem) {
    [data-sheets] .application { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    [data-sheets] .project .cover-print { grid-column: 1 / -1; }
    [data-sheets] .cover-print img { block-size: clamp(7.5rem, 44vw, 12rem); }
    [data-sheets] .companion img { block-size: clamp(5.5rem, 28vw, 9rem); }
  }
  @container homepage (max-width: 23rem) {
    [data-sheets] .project { grid-template: 'name' auto 'meta' auto 'prints' auto / minmax(0, 1fr); row-gap: 0.5rem; }
    [data-sheets] .project-meta { flex-direction: row; gap: 0.65rem; justify-self: start; }
  }
  @container homepage (max-width: 17rem) {
    [data-sheets] .application { grid-template-columns: minmax(0, 1fr); }
  }
</style>
