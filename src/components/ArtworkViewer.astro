<dialog class="art-viewer" aria-label="Artwork viewer">
  <header class="viewer-header">
    <span class="type-label" data-viewer-position></span>
    <button type="button" data-viewer-close>Close</button>
  </header>
  <div class="viewer-stage" id="artwork-stage">
    <div class="viewer-pan" role="region" aria-labelledby="artwork-caption" aria-describedby="zoom-help" tabindex="-1">
      <img data-viewer-image alt="" draggable="false" />
    </div>
  </div>
  <footer class="viewer-footer">
    <div aria-live="polite" aria-atomic="true">
      <p class="viewer-caption" id="artwork-caption" data-viewer-caption></p>
      <p class="type-label" data-viewer-error hidden></p>
      <span class="visually-hidden" data-viewer-announcement></span>
    </div>
    <div class="viewer-controls">
      <a data-viewer-original tabindex="0">Open full size</a>
      <button type="button" data-viewer-zoom aria-pressed="false" aria-controls="artwork-stage"
        aria-describedby="zoom-help">2× zoom</button>
      <span class="visually-hidden" id="zoom-help">When zoomed in, drag, swipe or use the arrow keys to pan.</span>
      <div class="viewer-pager">
        <button type="button" data-viewer-prev>Previous</button>
        <button type="button" data-viewer-next>Next</button>
      </div>
    </div>
  </footer>
</dialog>

<script>
  import '../scripts/artwork-viewer';
</script>

<style>
