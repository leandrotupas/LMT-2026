---
import HomeBand from '../components/HomeBand.astro';
import HomeCases from '../components/HomeCases.astro';
import HomeContact from '../components/HomeContact.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeIndex from '../components/HomeIndex.astro';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`${profile.name} — ${profile.role}`}
  description={`Selected brand and graphic design by ${profile.name} in ${profile.location}. Explore Advenient, KOTA Center Davao, Wünderbar and YANCEYANCEREVOLUTION.`}
>
  <HomeHero />
  <HomeCases />
  <HomeBand />
  <HomeIndex />
  <HomeContact />
  <figure class="peek" aria-hidden="true" data-peek>
    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" width="840" height="472" alt="" />
    <figcaption class="type-label"></figcaption>
  </figure>
</BaseLayout>

<style>
  .peek {
    position: fixed;
    z-index: 30;
    inset: 0 auto auto 0;
    inline-size: clamp(16rem, 26vw, 26rem);
    pointer-events: none;
    opacity: 0;
    scale: 0.92;
    /* It appears to the right of the cursor, so it grows from that side; it leaves faster than it arrives. */
    transform-origin: left center;
    transition: opacity 150ms var(--ease-out-strong), scale 150ms var(--ease-out-strong);
  }

  .peek.is-on { opacity: 1; scale: 1; transition-duration: 250ms; }
  .peek img {
    inline-size: 100%;
    box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.5);
    transition: filter 200ms var(--ease-out-strong), opacity 200ms var(--ease-out-strong);
  }
  /* A brief blur hides the cut when the preview switches between projects. */
  .peek img.is-swapping { filter: blur(2px); opacity: 0.6; transition-duration: 0s; }
  .peek figcaption { margin-block-start: 0.75rem; color: var(--color-ink); }

  @media (hover: none), (pointer: coarse), (max-width: 51.25em) { .peek { display: none; } }
  @media (prefers-reduced-motion: reduce) { .peek { transition: opacity 150ms var(--ease-out-strong); scale: 1; } }
</style>

<script>
  import { easeOut, gsap } from '../scripts/smooth';

  // A preview follows a fine pointer over the case rows and the index; touch shows thumbnails instead.
  const peek = document.querySelector<HTMLElement>('[data-peek]');
  const fine = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 51.3125em)');
  if (peek && fine.matches) {
    const image = peek.querySelector('img')!;
    const caption = peek.querySelector('figcaption')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const moveX = gsap.quickTo(peek, 'x', { duration: still ? 0 : 0.55, ease: easeOut });
    const moveY = gsap.quickTo(peek, 'y', { duration: still ? 0 : 0.55, ease: easeOut });
    addEventListener('pointermove', (event) => {
      moveX(Math.min(event.clientX + 28, innerWidth - peek.offsetWidth - 16));
      moveY(Math.max(16, event.clientY - peek.offsetHeight * 0.55));
    }, { passive: true });
    // Leaving one row fires before entering the next, so hiding waits a moment; moving row to row swaps instead of flickering.
    let hide = 0;
    document.querySelectorAll<HTMLAnchorElement>('[data-preview]').forEach((link) => {
      link.addEventListener('pointerenter', () => {
        clearTimeout(hide);
        const next = link.dataset.preview!;
        if (peek.classList.contains('is-on') && !image.src.endsWith(next)) {
          image.classList.add('is-swapping');
          image.addEventListener('load', () => requestAnimationFrame(() => image.classList.remove('is-swapping')), { once: true });
        }
        image.src = next;
        caption.textContent = link.dataset.previewCaption ?? '';
        peek.classList.add('is-on');
      });
      link.addEventListener('pointerleave', () => { hide = window.setTimeout(() => peek.classList.remove('is-on'), 80); });
    });
  }
</script>
