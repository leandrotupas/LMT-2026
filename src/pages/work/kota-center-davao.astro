---
import CaseOpener from '../../components/CaseOpener.astro';
import CaseFigure from '../../components/CaseFigure.astro';
import { kota, kotaArt as art } from '../../data/kota';
import CaseLayout from '../../layouts/CaseLayout.astro';

const wide = '(min-width: 90em) 867px, (min-width: 64em) 65vw, calc(100vw - 2rem)';
const half = '(min-width: 90em) 644px, (min-width: 48em) 46vw, calc(100vw - 2rem)';
---

<CaseLayout project={kota} subject="Community identity">
  <CaseOpener slot="opener" art={art.cover} field={kota.identityColor} sharesCover={kota.sharesCover} />
  <section class="opening layout-grid" aria-label="KOTA’s event and Story templates">
    <p class="brief prose">{kota.brief}</p>
    <CaseFigure class="story" art={art.story} sizes="(min-width: 64em) 16rem, (min-width: 48em) 21vw, (min-width: 37.5em) 16rem, (min-width: 26.5em) 45vw, min(76vw, 16rem)" loading="eager" />
  </section>

  <section class="chapter" aria-labelledby="origin-heading">
    <div class="origin layout-grid">
      <div class="origin-copy">
        <h2 id="origin-heading">A K in a borrowed book</h2>
        <div class="prose">
          <p>{kota.inspiration}</p>
          <p>{kota.decision}</p>
          <p>{kota.symbol}</p>
        </div>
      </div>
      <CaseFigure class="references" art={art.references} sizes={wide} detailLabel="View the symbol diagram at full size" />
    </div>
    <div class="identity layout-grid">
      <p class="system prose">{kota.system}</p>
      <CaseFigure class="lockup" art={art.lockup} sizes={half} />
      <CaseFigure class="motif" art={art.motif} sizes={half} />
    </div>
  </section>

  <section class="chapter" aria-labelledby="templates-heading">
    <div class="section-intro layout-grid">
      <h2 id="templates-heading">One frame, three square posts</h2>
      <p class="prose">{kota.templates}</p>
    </div>
    <div class="squares">
      <CaseFigure art={art.outline} sizes="(min-width: 75em) 493px, (min-width: 37.5em) 42vw, calc(100vw - 2rem)" />
      <CaseFigure art={art.panel} sizes="(min-width: 75em) 309px, (min-width: 37.5em) 25vw, 43vw" />
      <CaseFigure art={art.cutout} sizes="(min-width: 75em) 309px, (min-width: 37.5em) 25vw, 43vw" />
    </div>
  </section>

  <section class="handover chapter layout-grid" aria-labelledby="handover-heading">
    <div class="handover-copy">
      <h2 id="handover-heading">After handover</h2>
      <p class="prose">{kota.outcome}</p>
    </div>
    <CaseFigure class="later" art={art.later} sizes="(min-width: 64em) 390px, (min-width: 48em) 32vw, 75vw" />
  </section>
</CaseLayout>

<style>
  .opening {
    align-items: start;
    row-gap: var(--space-related);
    padding-block-start: clamp(1.4rem, 3vw, 2.85rem);
  }
  .opening .brief { grid-column: 1 / 3; align-self: center; }
  .opening .story { grid-column: 3 / -1; inline-size: 100%; max-inline-size: 16rem; justify-self: end; }
  .origin, .identity, .section-intro, .handover { row-gap: var(--space-related); align-items: start; }
  .origin-copy .prose, .handover-copy .prose { margin-block-start: 1rem; }
  .identity { margin-block-start: clamp(2.25rem, 4.8vw, 4.5rem); }
  .squares {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    gap: var(--space-related) var(--grid-gap);
    max-inline-size: 1160px;
    margin-block-start: var(--space-related);
    margin-inline-start: auto;
  }
  .squares :global(figure:first-child) { grid-column: 1 / -1; }
  .later { inline-size: min(78%, 390px); justify-self: end; }

  @container case-page (min-width: 32rem) {
    .opening .brief { grid-column: 1 / 5; }
    .opening .story { grid-column: 6 / -1; }
    .squares { grid-template-columns: minmax(0, 1.6fr) repeat(2, minmax(0, 1fr)); }
    .squares :global(figure:first-child) { grid-column: auto; }
  }
  @container case-page (min-width: 43rem) {
    .opening .brief { grid-column: 1 / 7; grid-row: 1; max-inline-size: 48ch; }
    .opening .story { grid-column: 7 / -1; grid-row: 1; align-self: end; }
    .origin-copy { grid-column: 1 / 4; }
    .references { grid-column: 4 / -1; align-self: center; }
    .system { grid-column: 1 / 7; }
    .lockup { grid-column: 1 / 5; }
    .motif { grid-column: 5 / -1; }
    .section-intro h2 { grid-column: 1 / 4; }
    .section-intro .prose { grid-column: 4 / -1; }
    .handover-copy { grid-column: 1 / 6; }
    .later { grid-column: 6 / -1; inline-size: min(100%, 390px); }
  }
  @container case-page (min-width: 56rem) {
    .opening .brief { grid-column: 1 / 8; }
    .opening .story { grid-column: 10 / -1; justify-self: start; }
    .origin-copy { grid-column: 1 / 5; }
    .references { grid-column: 6 / -1; }
    .system { grid-column: 1 / 8; }
    .lockup { grid-column: 1 / 7; }
    .motif { grid-column: 7 / -1; }
    .section-intro h2 { grid-column: 1 / 5; }
    .section-intro .prose { grid-column: 6 / 12; }
    .handover-copy { grid-column: 2 / 7; }
    .later { grid-column: 8 / 12; }
  }
  @container case-page (width < 24rem) {
    .opening .brief, .opening .story { grid-column: 1 / -1; }
    .opening .story { inline-size: min(76%, 16rem); }
  }
  @container case-page (max-width: 19rem) {
    .squares { grid-template-columns: minmax(0, 1fr); }
  }
</style>
