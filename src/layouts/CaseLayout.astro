---
import type { CaseStudy } from '../data/flagships';
import { workEntries } from '../data/work';
import { profile } from '../data/profile';
import ProjectName from '../components/ProjectName.astro';
import WorkFooter from '../components/WorkFooter.astro';
import BaseLayout from './BaseLayout.astro';
import '../styles/case-studies.css';

interface Props {
  project: CaseStudy;
  subject?: string;
}

const { project, subject = 'Brand identity' } = Astro.props;
const entry = workEntries.find(({ slug }) => slug === project.slug);
if (!entry) throw new Error(`Missing Work index entry for ${project.slug}`);
const { title, titleParts, year, category, next } = entry;
---

<BaseLayout title={`${title} · ${subject} · ${profile.name}`} description={project.introduction}
  share={{ slug: entry.slug, alt: `${title}. ${entry.alt}` }} artworkViewer>
  <article class="case-page container" aria-labelledby="case-heading" data-project={project.slug}>
    <nav class="breadcrumb type-label" aria-label="Breadcrumb">
      <a href="/work/" tabindex="0">Work</a><span aria-hidden="true">/</span><a href={category.href} tabindex="0">{category.title}</a>
    </nav>

    <header class="case-header layout-grid">
      <div class="heading-block">
        <h1 id="case-heading"><span data-case-title><ProjectName {title} {titleParts} /></span></h1>
        <p class="case-meta"><time datetime={String(year)}>{year}</time><span aria-hidden="true"> · </span>{project.role}</p>
      </div>
      <p class="introduction type-lead">{project.introduction}</p>
    </header>

    <slot />

    <section class="credits chapter layout-grid" aria-labelledby="credits">
      <div class="credit-heading">
        <h2 id="credits">Credits</h2>
        <p class="type-label"><ProjectName {title} {titleParts} />, {year}</p>
      </div>
      <dl>
        {project.credits.map(({ role, people }) => <div><dt>{role}</dt><dd>{people}</dd></div>)}
      </dl>
      <div class="documents type-label">
        {project.documents.map(({ label, href, pages }) => (
          <a href={href} type="application/pdf" tabindex="0">{label} <span>(PDF, {pages} pages)</span></a>
        ))}
      </div>
    </section>

    <WorkFooter {category} {next} nextLabel={next.format === 'case' ? 'Next case study' : 'Next project'} />
  </article>
</BaseLayout>
