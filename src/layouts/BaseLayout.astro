---
import displayFont from '../assets/fonts/bricolage-grotesque-wdth-latin.woff2?url';
import { profile } from '../data/profile';
import ArtworkViewer from '../components/ArtworkViewer.astro';
import CursorBadge from '../components/CursorBadge.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import '../styles/transitions.css';

interface Props {
  title: string;
  description: string;
  artworkViewer?: boolean;
  /** The page opens with full-bleed artwork under the header. */
  bleed?: boolean;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  share?: { slug: string; alt: string };
}

const { title, description, artworkViewer = false, bleed = false, noindex = false, share } = Astro.props;
const sharePath = `/images/share/${share?.slug ?? 'portfolio'}.jpg`;
const shareAlt = share?.alt ?? `${profile.name} with the Advenient playbook, KOTA event cover and Wünderbar business cards.`;
const canonical = !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const shareUrl = Astro.site ? new URL(sharePath, Astro.site).href : sharePath;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!canonical && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0b0712" />
    <!-- Google Search Console ownership (URL-prefix property for https://lmt-2026.vercel.app/). -->
    <meta name="google-site-verification" content="oLckE_xkTiTDaZGsJv6aFvkPa9wFur2vHBlbaOzvCDw" />
    <meta property="og:type" content={share ? 'article' : 'website'} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin="anonymous" />
    <style is:inline>
      /* Make the navigation preference available on a first visit, before external CSS loads. */
      @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
        @view-transition { navigation: auto; }
      }
    </style>
    <slot name="head" />
    <script is:inline>
      // Apply a saved day-mode choice before first paint, so the page never flashes the other theme.
      try { if (localStorage.getItem('yancy:theme') === 'day') document.documentElement.dataset.theme = 'day'; } catch { /* Night is the default. */ }
    </script>
    <script is:inline>
      // Carry the activating input across an ordinary full-page link, including in browsers without page transitions.
      try {
        const stored = sessionStorage.getItem('yancy:next-navigation');
        if (stored) {
          sessionStorage.removeItem('yancy:next-navigation');
          const arrival = JSON.parse(stored);
          if (arrival.url === location.href && Date.now() - arrival.time < 15000) {
            document.documentElement.dataset.input = arrival.input;
          }
        }
      } catch { /* The document is fully usable when storage is unavailable. */ }

      function connectProject(activation, transition, capturePhase) {
        if (!activation?.from?.url || !activation.entry?.url) return;
        const from = new URL(activation.from.url);
        const to = new URL(activation.entry.url);
        if (from.origin !== location.origin || to.origin !== location.origin || from.pathname === to.pathname) return;
        const isProject = (path) => /^\/work\/[^/]+\/$/.test(path);
        const isIndex = (path) => path === '/' || path === '/work/';
        if (![from.pathname, to.pathname].every((path) => isProject(path) || isIndex(path))) return;
        const back = activation.navigationType === 'traverse' && activation.entry.index < activation.from.index;
        const project = (back ? [from, to] : [to, from]).find((url) => isProject(url.pathname));
        if (!project) return;
        const onProject = location.pathname === project.pathname;
        const link = onProject ? null : Array.from(document.querySelectorAll('a[data-case-link]'))
          .find((item) => item.pathname === project.pathname);
        function capture(element, name) {
          if (!element) return;
          const box = element.getBoundingClientRect();
          if (!box.width || !box.height || box.bottom <= 0 || box.top >= innerHeight) return;
          element.style.viewTransitionName = name;
          const clear = () => element.style.removeProperty('view-transition-name');
          transition[capturePhase].then(clear, clear);
        }
        capture(onProject ? document.querySelector('h1 [data-case-title]') : link?.querySelector('[data-case-title]'), 'case-title');
        if (!isIndex(from.pathname) && !isIndex(to.pathname)) return;
        let cover;
        // On the homepage the visible artwork is the cursor preview, so it flies into the project's opener.
        const preview = document.querySelector('.peek.is-on img');
        if (onProject) cover = document.querySelector('img[data-case-cover]');
        else if (preview && link?.hasAttribute('data-share-cover')) cover = preview;
        else if (link?.hasAttribute('data-share-cover')) {
          cover = link.hasAttribute('data-previewed') ? document.querySelector('.preview-frame > img') : link.querySelector('img');
        }
        if (cover?.complete && cover.naturalWidth) capture(cover, 'case-art');
      }

      window.addEventListener('pageswap', (event) => {
        const transition = event.viewTransition;
        if (!transition) return;
        const destination = event.activation?.entry?.url;
        const opensArtwork = destination && /\.(?:webp|pdf)$/i.test(new URL(destination).pathname);
        if (opensArtwork || document.documentElement.dataset.input === 'keyboard' || document.activeElement?.matches('a:focus-visible')) {
          // Native files and keyboard navigation open immediately.
          transition.ready.catch((error) => {
            if (error.name !== 'AbortError') console.error(error);
          });
          transition.skipTransition();
          return;
        }
        connectProject(event.activation, transition, 'finished');
      });
      window.addEventListener('pagereveal', (event) => {
        if (event.viewTransition) connectProject(window.navigation?.activation, event.viewTransition, 'ready');
      });
    </script>
  </head>
  <body class:list={{ 'is-home': Astro.url.pathname === '/', 'is-bleed': bleed }}>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {artworkViewer && <ArtworkViewer />}
    <CursorBadge />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
